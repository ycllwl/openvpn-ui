# ─────────────────────────────────────────────
# OpenVPN（飞牛 .250）环境变量模板 —— 改完重启栈生效
# ─────────────────────────────────────────────

TZ=Asia/Shanghai

# ── 服务端监听（必须与 server.conf 的 port 一致，也与路由器转发一致）──
OVPN_PORT=1195
OVPN_PROTO=udp

# ── VPN 虚拟网段（容器内 iptables/NAT 用，必须和 server.conf 的 server 行一致）──
TRUST_SUB=10.8.0.0/24
GUEST_SUB=10.8.1.0/24

# ── 家庭内网：推送给客户端 + 容器内做 NAT 出网 ──
HOME_SUB=192.168.1.0/24
HOME_SUBNET=192.168.1.0/24
HOME_DNS_1=192.168.1.1
HOME_DNS_2=223.5.5.5
MAX_CLIENTS=20

# ── 客户端连接参数（生成 .ovpn 时写入 remote 行）──
CLIENT_HOST=vpn.example.com
CLIENT_PORT=1195
CLIENT_PROTO=udp

# ── 管理面板 ──
UI_PORT=8080
UI_ADMIN_USER=admin
UI_ADMIN_PASSWORD=改成你自己的密码

# ── EasyRSA 证书字段 ──
# 注意：改这些只影响"之后签发"的证书；不要点面板里的 Regenerate CA，会作废现有客户端
EASYRSA_DN=org
EASYRSA_REQ_COUNTRY=CN
EASYRSA_REQ_PROVINCE=GD
EASYRSA_REQ_CITY=Guangzhou
EASYRSA_REQ_ORG=example
EASYRSA_REQ_EMAIL=admin@example.com
EASYRSA_REQ_OU=VPN
EASYRSA_KEY_SIZE=2048
EASYRSA_CA_EXPIRE=3650
EASYRSA_CERT_EXPIRE=825
EASYRSA_CRL_DAYS=180
EASYRSA_CERT_RENEW=30

# ── 目录 ──
DATA_DIR=/vol2/1000/docker/compose/openvpn
